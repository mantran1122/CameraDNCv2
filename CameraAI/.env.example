# Local-only configuration. Copy to .env or configure through the dashboard.
ADMIN_DATABASE_USERNAME=admin
ADMIN_DATABASE_PASSWORD=namcantho@168

# Internal AI Server (2x NVIDIA H200)
QWEN_SERVER_URL=https://llm.ttpmsandbox.us.kg/v1
QWEN_API_KEY=
QWEN_MODEL_NAME=Qwen3.8-27B
DENSE_FRAMES_COUNT=8
MAX_VLM_FRAMES=8

# Internal Audio AI Server (Speech-to-Text & Acoustic Anomaly)
INTERNAL_AUDIO_SERVER_URL=https://llm.ttpmsandbox.us.kg/v1/audio
INTERNAL_AUDIO_SERVER_API_KEY=
INTERNAL_AUDIO_MODEL_NAME=Internal Audio AI (Server AI)
USE_DEEPFILTER=true

# Storage & Dual-write Database
CAMERAAI_STORAGE_BACKEND=synology
CAMERAAI_CLIPS_DIR=storage/clips
CAMERAAI_RETENTION_DAYS=30
CAMERAAI_SYNOLOGY_URL=https://192.168.100.9:5001
CAMERAAI_SYNOLOGY_USERNAME=
CAMERAAI_SYNOLOGY_PASSWORD=
CAMERAAI_SYNOLOGY_SHARE=Ai-Camera
CAMERAAI_SYNOLOGY_ROOT=CameraAI/clips
# Keep true with a trusted NAS certificate. Set false only for a private/self-signed certificate.
CAMERAAI_SYNOLOGY_VERIFY_TLS=false
CAMERAAI_SYNOLOGY_TIMEOUT_SECONDS=60
CAMERAAI_SESSION_SECRET=
CAMERAAI_SESSION_MAX_AGE_SECONDS=28800
# Enable only when CameraAI itself is served through HTTPS.
CAMERAAI_SESSION_COOKIE_SECURE=false
CAMERAAI_POSTGRES_DUAL_WRITE=true
CAMERAAI_POSTGRES_URL=postgresql://camera_user:camera_secure_pass168@localhost:5432/camera_ai

